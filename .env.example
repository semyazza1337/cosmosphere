# Copy to .env and fill in the key(s) for the provider(s) you want to use

# Anthropic — default provider (claude-haiku-4-5-20251001)
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI — optional (gpt-4o-mini); install: uv sync --extra openai
OPENAI_API_KEY=sk-...

# Gemini — optional (gemini-2.5-flash); install: uv sync --extra gemini
GEMINI_API_KEY=AI...

# NASA APOD — optional, DEMO_KEY works for light usage
# NASA_API_KEY=DEMO_KEY

# Quartz blog repo path (used by --publish)
# BLOG_REPO_PATH=/home/weck/src/quartz-blog

# Override model for any provider (optional)
# COSMOSPHERE_MODEL=claude-sonnet-4-6
